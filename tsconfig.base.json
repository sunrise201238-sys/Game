{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "aslingshot/shared": ["shared/src"],
      "aslingshot/shared/*": ["shared/src/*"],
      "@i18n/*": ["i18n/*"]
    }
  }
}
